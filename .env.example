# Runtime
POSTGRESQL_URL=postgresql://user:password@host:5432/database
DEFAULT_NEWS_SOURCE=sakal

# OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_PLANNER_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Azure OpenAI, optional alternative to direct OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_EMBEDDING_API_VERSION=
AZURE_OPENAI_CHAT_API_VERSION=2025-04-01-preview
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_PLANNER_DEPLOYMENT=

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
PINECONE_NAMESPACE=default

# Sakal source
SAKAL_PINECONE_INDEX_NAME=sakal
SAKAL_PINECONE_INDEX_HOST=
SAKAL_PINECONE_NAMESPACE=sakal_v1
SAKAL_BM25_ENCODER_PATH=bm25_sakal_values.json

# Bar & Bench source
BARANDBENCH_PINECONE_INDEX_HOST=
BARANDBENCH_PINECONE_NAMESPACE=barandbench
BARANDBENCH_BM25_ENCODER_PATH=bm25_barandbench_values.json

# Retrieval
RETRIEVAL_TOP_K=10
HYBRID_ALPHA=0.5
RERANK_MODE=none

# Optional Jina reranker, used only when RERANK_MODE=jina
JINA_API_KEY=
JINA_RERANK_URL=https://api.jina.ai/v1/rerank
JINA_RERANK_MODEL=jina-reranker-v3
JINA_RERANK_TOP_N=10
